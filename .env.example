APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# PBB Bapenda API (PTPOS Kota Baubau)
PBB_BAPENDA_BASE_URL=
PBB_BAPENDA_USERNAME=
PBB_BAPENDA_PASSWORD=
PBB_BAPENDA_OUTLET=ptpos

# SNAP BI / BRI sandbox foundation
SNAP_MODE=sandbox
BRI_SNAP_PARTNER_ID=test-partner
BRI_SNAP_CLIENT_KEY=test-client
BRI_SNAP_CLIENT_SECRET=
BRI_SNAP_PUBLIC_KEY=
BRI_SNAP_PUBLIC_KEY_PATH=
BRI_SNAP_MPAD_PRIVATE_KEY_PATH=
BRI_SNAP_MPAD_PUBLIC_KEY_PATH=
BRI_SNAP_CALLBACK_BASE_URL="${APP_URL}"
BRI_SNAP_ALLOWED_IPS=
BRI_SNAP_TIMESTAMP_TOLERANCE_SECONDS=300
BRI_SNAP_TOKEN_TTL_SECONDS=900
BRI_SNAP_IDEMPOTENCY_TTL_MINUTES=1440
BRI_SNAP_REQUIRE_BEARER_TOKEN=true
PBB_BAPENDA_OUTLET=

# BRI SNAP SANDBOXING CREDENTIALS
BRI_SNAP_CLIENT_ID=
BRI_SNAP_CLIENT_SECRET=
BRI_SNAP_URL_SERVICE_TOKEN=
BRI_SNAP_URL_SERVICE_NOTIFY=
BRI_SNAP_NOTIFICATION_EMAIL=
