#!/usr/bin/expect -f
set timeout 30
set password "[REDACTED]"
set host "157.10.252.74"
set user "sipanda"

spawn ssh $user@$host "ls -la /home/sipanda/retribusi-admin/dist/index.html /home/sipanda/retribusi-petugas/dist/index.html && sudo tail -n 20 /var/log/nginx/error.log"
expect "password:"
send "$password\r"
expect {
    "password:" { send "$password\r"; exp_continue }
    eof
}
