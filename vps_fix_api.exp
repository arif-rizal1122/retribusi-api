#!/usr/bin/expect -f
set timeout 120
set password "Sipanda123#"
spawn ssh -o StrictHostKeyChecking=no sipanda@157.10.252.74
expect "password:"
send "$password\r"
expect "$ "

# Masuk ke folder API Production
send "cd /home/sipanda/retribusi-api\r"
expect "$ "

# Reset perubahan lokal (aman untuk kode, tidak hapus DB)
send "git reset --hard\r"
expect "$ "

# Fix Permissions (PENTING)
send "echo '$password' | sudo -S chown -R sipanda:www-data storage bootstrap/cache\r"
expect "$ "
send "echo '$password' | sudo -S chmod -R 775 storage bootstrap/cache\r"
expect "$ "

# Pull perubahan terbaru
send "git pull origin main\r"
expect "$ "

# Update dependencies
send "composer install --no-dev --optimize-autoloader\r"
expect "$ "

# Jalankan migrasi
send "php artisan migrate --force\r"
expect "$ "

# Clear & Cache Routes (Fix 404)
send "php artisan route:clear\r"
expect "$ "
send "php artisan route:cache\r"
expect "$ "

# Clear & Cache Config
send "php artisan config:clear\r"
expect "$ "
send "php artisan config:cache\r"
expect "$ "

# Restart Queue
send "php artisan queue:restart\r"
expect "$ "

send "exit\r"
expect eof
