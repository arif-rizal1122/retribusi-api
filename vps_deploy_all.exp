#!/usr/bin/expect -f
set timeout 300
set password "[REDACTED]"
set host "157.10.252.74"
set user "sipanda"

# Ensure directories exist
spawn ssh $user@$host "mkdir -p /home/sipanda/retribusi-admin/dist /home/sipanda/retribusi-mobile/dist /home/sipanda/retribusi-petugas/dist"
expect "password:"
send "$password\r"
expect eof

# Deploy Admin
spawn scp -r /Users/pondokit/Herd/retribusi-admin/dist/. $user@$host:/home/sipanda/retribusi-admin/dist/
expect "password:"
send "$password\r"
expect eof

# Deploy Petugas
spawn scp -r /Users/pondokit/Herd/retribusi-petugas/dist/. $user@$host:/home/sipanda/retribusi-petugas/dist/
expect "password:"
send "$password\r"
expect eof

# Deploy Mobile
spawn scp -r /Users/pondokit/Herd/retribusi-mobile/dist/. $user@$host:/home/sipanda/retribusi-mobile/dist/
expect "password:"
send "$password\r"
expect eof
