#!/usr/bin/expect -f
set timeout 60
set password "Sipanda123#"
spawn ssh -o StrictHostKeyChecking=no sipanda@157.10.252.74
expect "password:"
send "$password\r"
expect "$ "
send "cd /home/sipanda/retribusi-api\r"
expect "$ "
send "echo '$password' | sudo -S chown -R sipanda:www-data .\r"
expect "$ "
send "echo '$password' | sudo -S chmod -R 775 storage bootstrap/cache\r"
expect "$ "
send "truncate -s 0 storage/logs/laravel.log\r"
expect "$ "
send "chmod 666 storage/logs/laravel.log\r"
expect "$ "
send "php artisan optimize:clear\r"
expect "$ "
send "php artisan config:cache\r"
expect "$ "
send "php artisan route:list | grep pbb\r"
expect "$ "
send "exit\r"
expect eof
