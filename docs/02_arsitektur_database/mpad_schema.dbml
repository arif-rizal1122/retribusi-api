Table bills {
  id "bigint unsigned" [pk]
  taxpayer_id "bigint unsigned"
  tax_object_id "bigint unsigned"
  opd_id "bigint unsigned"
  user_id "bigint unsigned"
  retribution_type_id "bigint unsigned"
  retribution_classification_id "bigint unsigned"
  bill_number "varchar(255)"
  amount "decimal(15,2)"
  admin_fee "decimal(15,2)"
  penalty_amount "decimal(15,2)"
  waived_penalty_amount "decimal(15,2)"
  penalty_type "varchar(255)"
  fixed_fine_amount "decimal(15,2)"
  surcharge_amount "decimal(15,2)"
  status "varchar(255)"
  postponed_at "timestamp"
  reason_postponed "text"
  period "varchar(255)"
  period_start "date"
  period_end "date"
  metadata "json"
  due_date "timestamp"
  created_at "timestamp"
  updated_at "timestamp"
  spot_check_id "bigint unsigned"
}

Table complaints {
  id "bigint unsigned" [pk]
  taxpayer_id "bigint unsigned"
  name "varchar(255)"
  email "varchar(255)"
  phone "varchar(255)"
  category "varchar(255)"
  complaint_text "text"
  rating "int"
  suggestion_text "text"
  attachments "json"
  status "enum('pending','processing','resolved','rejected')"
